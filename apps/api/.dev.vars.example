# Copy to .dev.vars (gitignored) and fill in values for local `wrangler dev`.
# Production values are set via `wrangler secret put`.

# Bearer-secret for the API. Any string; share between API and clients.
WRITER_OS_API_SECRET="dev-secret-change-me"

# Postgres connection string. For local dev with PGlite-backed Worker tests
# this is unused; for deployed Worker hitting Supabase, set to the pooled
# connection URL (Supabase project settings → Database → Connection pooling).
DATABASE_URL=""

# Anthropic API key — used by LLMClient (slice #6 onward).
# Get one at https://console.anthropic.com/. Buy prepaid credits with
# auto-refill OFF as a hard cap on spend. Format: sk-ant-api03-...
ANTHROPIC_API_KEY=""

# Inbox triage confidence thresholds. Defaults shown; leave commented unless tuning.
# WRITER_OS_TRIAGE_HIGH_CONFIDENCE="0.80"
# WRITER_OS_TRIAGE_LOW_CONFIDENCE="0.50"

# ElevenLabs API key — used by TTSStreamer (slice #8 onward).
# Get one at https://elevenlabs.io/app/settings/api-keys. Free tier covers
# initial dev; prepay $20 with auto-refill OFF before sustained usage.
# Format: sk_...
ELEVENLABS_API_KEY=""
